    "qrcode": "^1.5.4",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@php-wasm/cli": "3.1.56",
    "@prettier/plugin-php": "^0.25.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
